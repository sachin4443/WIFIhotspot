{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "NxtHotspot": ""
  },
  "Jwt": {
    "Issuer": "NxtHotspot",
    "Audience": "NxtHotspot.Admin",
    "AccessTokenMinutes": 30,
    "Key": ""
  },
  "Security": {
    "EncryptionKey": ""
  },
  "Sms": {
    "AllowedHosts": [ "2factor.in" ],
    "DefaultEndpoint": "https://2factor.in/API/R1/"
  },
  "Bootstrap": {
    "SuperAdmin": {
      "Username": "",
      "Password": "",
      "Email": ""
    }
  },
  "Radius": {
    "PublicAddress": "",
    "PortalBaseUrl": "",
    "AuthPort": 1812,
    "AcctPort": 1813,
    "StaleSessionMinutes": 30,
    "PortalCredentialSeconds": 120
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
