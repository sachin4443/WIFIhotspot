# Copy to .env.local (git-ignored) only if you need to change the defaults.
# Never put secrets here: everything prefixed VITE_ is bundled into the browser.

# Base URL the browser uses for API calls.
# Leave empty in development so requests go through the Vite proxy (same origin, no CORS).
# For a production build, set the public API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api to (development only).
# Matches Backend/NxtHotspot.API/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=https://localhost:57314
